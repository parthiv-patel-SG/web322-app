<%- include('layouts/main') %>

<div class="row">
    <div class="col-md-12">
        <h2>Categories
            <a href="/categories/add" class="btn btn-success pull-right">Add Category</a>
        </h2>
        <hr />
        
        <% if (categories && categories.length > 0) { %>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Category ID</th>
                            <th>Category Name</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categories.forEach(category => { %>
                            <tr>
                                <td><a href="/items?category=<%= category.id %>"><%= category.id %></a></td>
                                <td><a href="/items?category=<%= category.id %>"><%= category.category %></a></td>
                                <td><a href="/categories/delete/<%= category.id %>" class="btn btn-danger">remove</a></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="col-md-12 text-center">
                <strong>To add new categories you can click to add button...</strong>
            </div>
        <% } %>
    </div>
</div>